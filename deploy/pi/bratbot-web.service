[Unit]
Description=Bratbot static web server (serves the exported Expo web build)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bratbot
Environment=PORT=8080
ExecStart=/usr/bin/node server/static-server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
