[Unit]
Description=Bratbot RAG search server (retrieval over imported chat history)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bratbot
Environment=OLLAMA_URL=http://localhost:11434
Environment=EMBED_MODEL=nomic-embed-text
Environment=PORT=11435
ExecStart=/usr/bin/node server/rag-server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
